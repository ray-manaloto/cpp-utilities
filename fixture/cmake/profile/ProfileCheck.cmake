# Profile check module. A Profile preset loads it after project() through
# CMAKE_PROJECT_INCLUDE; ProfileRules.cmake has already checked the axis values
# and rules. It stops configure, listing every reason, when:
# - a compiler's ID, version or fork commit is not the profile's compiler;
# - a CMake setting the profile owns, or a flag its toolchain adds, was overridden,
#   including by a later flag that undoes it, in the base or a configuration's
#   flags variable;
# - the compiler or linker refuses a flag the profile adds, or IPO or
#   import std is asked for and unavailable.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ProfileCommon.cmake")
include(CheckCompilerFlag)
include(CheckLinkerFlag)
include(CheckIPOSupported)

# Appends to <out> a refusal for each flag in <required> that a later flag in
# <vars> undoes. <vars> are read in order, as the compiler sees them: the base
# variable, then a configuration's. A flag is undone by:
# - -fno-sanitize=<names> or =all, for a sanitizer a -fsanitize= flag turns on,
#   unless a later -fsanitize= turns it on again;
# - -f<x> after -fno-<x>, or -fno-<x> after -f<x>;
# - -<opt>=<other> after -<opt>=<value>.
# Flags a project adds itself, such as with add_compile_options, are not seen.
function(_profile_undone required vars out)
  set(refusals "${${out}}")
  set(seq "")
  set(src "")
  foreach(var IN LISTS vars)
    separate_arguments(tokens NATIVE_COMMAND "${${var}}")
    foreach(token IN LISTS tokens)
      list(APPEND seq "${token}")
      list(APPEND src "${var}")
    endforeach()
  endforeach()

  set(wanted "")
  foreach(flag IN LISTS required)
    if(flag MATCHES "^-fsanitize=(.+)$")
      string(REPLACE "," ";" names "${CMAKE_MATCH_1}")
      list(APPEND wanted ${names})
    endif()
  endforeach()
  set(on "")
  set(i 0)
  foreach(token IN LISTS seq)
    list(GET src ${i} var)
    math(EXPR i "${i} + 1")
    if(token MATCHES "^-f(no-)?sanitize=(.+)$")
      set(negated "${CMAKE_MATCH_1}")
      string(REPLACE "," ";" names "${CMAKE_MATCH_2}")
      if(negated AND "all" IN_LIST names)
        set(names ${wanted})
      endif()
      foreach(name IN LISTS names)
        if(negated)
          list(REMOVE_ITEM on "${name}")
          set(off_${name} "${var}")
        else()
          list(APPEND on "${name}")
          unset(off_${name})
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(name IN LISTS wanted)
    if(NOT name IN_LIST on AND DEFINED off_${name})
      list(APPEND refusals "${off_${name}} turns off sanitizer ${name}, which the profile turns on")
    endif()
  endforeach()

  foreach(flag IN LISTS required)
    if(flag MATCHES "^-f(no-)?sanitize=")
      continue()
    endif()
    set(negation "")
    set(prefix "")
    if(flag MATCHES "^-fno-([^=]+)$")
      set(negation "-f${CMAKE_MATCH_1}")
    elseif(flag MATCHES "^-f([^=]+)$")
      set(negation "-fno-${CMAKE_MATCH_1}")
    elseif(flag MATCHES "^(-[^=]+=)")
      set(prefix "${CMAKE_MATCH_1}")
    endif()
    set(last -1)
    set(i 0)
    foreach(token IN LISTS seq)
      if(token STREQUAL flag)
        set(last ${i})
      endif()
      math(EXPR i "${i} + 1")
    endforeach()
    if(last LESS 0)
      continue()
    endif()
    set(i 0)
    foreach(token IN LISTS seq)
      if(i GREATER last)
        string(FIND "${token}" "${prefix}" at)
        if((negation AND token STREQUAL negation) OR (prefix AND at EQUAL 0))
          list(GET src ${i} var)
          list(APPEND refusals "${var} has ${token} after ${flag}, which the profile adds")
        endif()
      endif()
      math(EXPR i "${i} + 1")
    endforeach()
  endforeach()
  set(${out} "${refusals}" PARENT_SCOPE)
endfunction()

function(_profile_check_build)
  set(refusals "")
  # Compiler identity.
  get_property(languages GLOBAL PROPERTY ENABLED_LANGUAGES)
  list(FILTER languages INCLUDE REGEX "^(C|CXX)$")
  set(expected "PROFILE_COMPILER_${PROFILE_COMPILER}")
  foreach(lang IN LISTS languages)
    set(id "${CMAKE_${lang}_COMPILER_ID}")
    string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" version "${CMAKE_${lang}_COMPILER_VERSION}")
    execute_process(COMMAND "${CMAKE_${lang}_COMPILER}" --version
      OUTPUT_VARIABLE banner ERROR_QUIET RESULT_VARIABLE ignored)
    set(commit "")
    if(banner MATCHES "clang-p2996\\.git ([0-9a-f]+)")
      string(SUBSTRING "${CMAKE_MATCH_1}" 0 8 commit)
    endif()
    if(NOT id STREQUAL "${${expected}_ID}" OR NOT version STREQUAL "${${expected}_VERSION}"
        OR NOT commit STREQUAL "${${expected}_COMMIT}")
      set(seen "${id} ${version}")
      if(commit)
        string(APPEND seen " commit ${commit}")
      endif()
      set(want "${${expected}_ID} ${${expected}_VERSION}")
      if(${expected}_COMMIT)
        string(APPEND want " commit ${${expected}_COMMIT}")
      endif()
      list(APPEND refusals "the ${lang} compiler ${CMAKE_${lang}_COMPILER} is ${seen}, but the profile names ${PROFILE_COMPILER}: ${want}")
    endif()
  endforeach()

  # Settings the profile owns, and the flags its toolchain adds.
  get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(multi_config)
    set(configs ${CMAKE_CONFIGURATION_TYPES})
  else()
    set(configs ${CMAKE_BUILD_TYPE})
  endif()
  set(suffixes "")
  foreach(config IN LISTS configs)
    string(TOUPPER "_${config}" up)
    list(APPEND suffixes "${up}")
  endforeach()
  if(NOT suffixes)
    set(suffixes "_NONE")
  endif()
  foreach(axis IN LISTS PROFILE_NAME_AXES)
    string(TOUPPER "${axis}" up)
    foreach(pair IN LISTS PROFILE_SETTINGS_${axis}_${PROFILE_${up}})
      string(FIND "${pair}" "=" at)
      string(SUBSTRING "${pair}" 0 ${at} var)
      math(EXPR at "${at} + 1")
      string(SUBSTRING "${pair}" ${at} -1 want)
      if(var STREQUAL "CMAKE_BUILD_TYPE" AND multi_config)
        continue()
      endif()
      set(same FALSE)
      if(want STREQUAL "ON" OR want STREQUAL "OFF")
        if((want AND ${var}) OR (NOT want AND NOT ${var}))
          set(same TRUE)
        endif()
      elseif("${${var}}" STREQUAL want)
        set(same TRUE)
      endif()
      if(NOT same)
        list(APPEND refusals "${var} is \"${${var}}\" but ${axis} ${PROFILE_${up}} sets \"${want}\"")
      endif()
    endforeach()
  endforeach()

  set(link "")
  foreach(lang IN LISTS languages)
    profile_flags(${lang} compile lang_link)
    list(APPEND link ${lang_link})
    separate_arguments(actual NATIVE_COMMAND "${CMAKE_${lang}_FLAGS}")
    foreach(flag IN LISTS compile)
      if(NOT flag IN_LIST actual)
        list(APPEND refusals "CMAKE_${lang}_FLAGS lacks ${flag}, which the profile adds")
      endif()
    endforeach()
    foreach(suffix IN LISTS suffixes)
      _profile_undone("${compile}" "CMAKE_${lang}_FLAGS;CMAKE_${lang}_FLAGS${suffix}" refusals)
    endforeach()
    set(CMAKE_REQUIRED_QUIET ON)
    foreach(flag IN LISTS compile)
      string(MAKE_C_IDENTIFIER "PROFILE_HAS_${lang}_FLAG_${flag}" result)
      unset(${result} CACHE)
      check_compiler_flag(${lang} "${flag}" ${result})
      if(NOT ${result})
        list(APPEND refusals "the ${lang} compiler refuses ${flag}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES link)
  separate_arguments(actual NATIVE_COMMAND "${CMAKE_EXE_LINKER_FLAGS}")
  foreach(suffix IN LISTS suffixes)
    _profile_undone("${link}" "CMAKE_EXE_LINKER_FLAGS;CMAKE_EXE_LINKER_FLAGS${suffix}" refusals)
  endforeach()
  foreach(flag IN LISTS link)
    if(NOT flag IN_LIST actual)
      list(APPEND refusals "CMAKE_EXE_LINKER_FLAGS lacks ${flag}, which the profile adds")
    endif()
    list(GET languages -1 lang)
    string(MAKE_C_IDENTIFIER "PROFILE_HAS_LINKER_FLAG_${flag}" result)
    unset(${result} CACHE)
    check_linker_flag(${lang} "${flag}" ${result})
    if(NOT ${result})
      list(APPEND refusals "the linker refuses ${flag}")
    endif()
  endforeach()

  if(PROFILE_IPO STREQUAL "ipo_on")
    check_ipo_supported(RESULT ipo OUTPUT why LANGUAGES ${languages})
    if(NOT ipo)
      list(APPEND refusals "IPO is not supported: ${why}")
    endif()
  endif()
  if(PROFILE_IMPORT_STD STREQUAL "importstd_on")
    string(REGEX MATCH "[0-9]+" std "${PROFILE_CXX_STANDARD}")
    if(NOT std IN_LIST CMAKE_CXX_COMPILER_IMPORT_STD)
      list(APPEND refusals "import std is not available for C++${std}: ${CMAKE_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE}")
    elseif(NOT IS_ABSOLUTE "${CMAKE_CXX_STDLIB_MODULES_JSON}" OR NOT EXISTS "${CMAKE_CXX_STDLIB_MODULES_JSON}")
      list(APPEND refusals "import std needs the standard library modules metadata, but CMAKE_CXX_STDLIB_MODULES_JSON is \"${CMAKE_CXX_STDLIB_MODULES_JSON}\"")
    endif()
  endif()

  list(REMOVE_DUPLICATES refusals)
  profile_refuse("${refusals}")
  message(STATUS "Profile ${PROFILE_NAME}: checks passed")
endfunction()

_profile_check_build()
