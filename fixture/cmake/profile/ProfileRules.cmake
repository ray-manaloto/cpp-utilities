# Profile rules module. A Profile preset loads it before project() through
# CMAKE_PROJECT_INCLUDE_BEFORE, so a forbidden combination stops configure
# with the catalogue's reasons before the compiler's own checks run. It
# refuses an unknown axis value, a PROFILE_NAME that is not the name the values
# spell, and any catalogue rule the profile and the build's system, arch,
# generator or launcher break. ProfileCheck.cmake checks the build after project().
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ProfileCommon.cmake")

# Sets <out> to the value paired with <key> in the key-value pairs that follow, or to <key>.
function(_profile_lookup key out)
  set(${out} "${key}" PARENT_SCOPE)
  while(ARGN)
    list(POP_FRONT ARGN k v)
    if(k STREQUAL key)
      set(${out} "${v}" PARENT_SCOPE)
      return()
    endif()
  endwhile()
endfunction()

function(_profile_check_rules)
  set(refusals "")
  if(NOT PROFILE_NAME)
    message(FATAL_ERROR "Profile check: PROFILE_NAME is not set; configure through a Profile preset")
  endif()

  # Axis values and the name they spell.
  set(spelled "")
  foreach(axis IN LISTS PROFILE_NAME_AXES)
    string(TOUPPER "${axis}" up)
    set(value "${PROFILE_${up}}")
    if(axis STREQUAL "sanitizer")
      profile_sanitizer_members("${value}" members)
      set(ordered "")
      foreach(m IN LISTS PROFILE_SANITIZER_MEMBERS)
        if(m IN_LIST members)
          list(APPEND ordered "${m}")
        endif()
      endforeach()
      list(JOIN ordered "_" canonical)
      if(NOT value STREQUAL "none" AND NOT value STREQUAL canonical)
        list(APPEND refusals "PROFILE_SANITIZER=\"${value}\" is not none or sanitizers from {${PROFILE_SANITIZER_MEMBERS}} in that order")
      endif()
    elseif(NOT value IN_LIST PROFILE_AXIS_${axis}_VALUES)
      list(APPEND refusals "PROFILE_${up}=\"${value}\" is not one of {${PROFILE_AXIS_${axis}_VALUES}}")
    endif()
    list(APPEND spelled "${value}")
  endforeach()
  list(JOIN spelled "-" name)
  if(NOT PROFILE_NAME STREQUAL name)
    list(APPEND refusals "PROFILE_NAME is \"${PROFILE_NAME}\" but the axis values spell \"${name}\"")
  endif()

  # Context the build decides.
  # The toolchain file does not cross-compile, so the host is the target
  # unless a CMAKE_SYSTEM_NAME was given.
  set(target "${CMAKE_HOST_SYSTEM_NAME}")
  if(CMAKE_SYSTEM_NAME)
    set(target "${CMAKE_SYSTEM_NAME}")
  endif()
  _profile_lookup("${target}" system Darwin macos Linux linux)
  if(NOT system STREQUAL PROFILE_SYSTEM)
    list(APPEND refusals "the build targets ${target} but the profile names ${PROFILE_SYSTEM}")
  endif()
  cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
  if(CMAKE_OSX_ARCHITECTURES)
    set(processor "${CMAKE_OSX_ARCHITECTURES}")
  endif()
  string(TOLOWER "${processor}" processor)
  _profile_lookup("${processor}" context_arch aarch64 arm64 x86_64 amd64)
  _profile_lookup("${CMAKE_GENERATOR}" context_generator
    Ninja ninja "Ninja Multi-Config" ninja_multi_config "Unix Makefiles" unix_makefiles Xcode xcode)
  set(context_launcher "none")
  if(CMAKE_CXX_COMPILER_LAUNCHER)
    list(GET CMAKE_CXX_COMPILER_LAUNCHER 0 launcher)
    get_filename_component(context_launcher "${launcher}" NAME_WE)
  endif()
  foreach(axis IN LISTS PROFILE_CONTEXT_AXES)
    if(NOT context_${axis} IN_LIST PROFILE_AXIS_${axis}_VALUES)
      list(APPEND refusals "${axis} \"${context_${axis}}\" is not one of {${PROFILE_AXIS_${axis}_VALUES}}")
    endif()
  endforeach()

  # Catalogue rules.
  profile_sanitizer_members("${PROFILE_SANITIZER}" members)
  foreach(id IN LISTS PROFILE_RULES)
    set(all TRUE)
    foreach(i IN LISTS PROFILE_RULE_${id}_CONDITIONS)
      set(axis "${PROFILE_RULE_${id}_${i}_AXIS}")
      if(axis STREQUAL "sanitizers")
        set(actual "${members}")
      elseif(axis IN_LIST PROFILE_CONTEXT_AXES)
        set(actual "${context_${axis}}")
      else()
        string(TOUPPER "${axis}" up)
        set(actual "${PROFILE_${up}}")
      endif()
      set(hit FALSE)
      foreach(v IN LISTS actual)
        if(v IN_LIST PROFILE_RULE_${id}_${i}_VALUES)
          set(hit TRUE)
        endif()
      endforeach()
      if(PROFILE_RULE_${id}_${i}_NEGATED)
        if(hit)
          set(hit FALSE)
        else()
          set(hit TRUE)
        endif()
      endif()
      if(NOT hit)
        set(all FALSE)
        break()
      endif()
    endforeach()
    if(all)
      list(APPEND refusals "${id}: ${PROFILE_RULE_${id}_MESSAGE}")
    endif()
  endforeach()

  profile_refuse("${refusals}")
endfunction()

_profile_check_rules()
