/// Renders one vcpkg overlay triplet per profile. Each chainloads the
/// catalogue's toolchain file and passes it the axes that change a library's ABI.
module triplets

import "../profile.pkl"
import "../settings.pkl"
import "cmake.pkl"
import "presets.pkl"

/// The axes a dependency is built with.
abiAxes: List<String> = List("system", "compiler", "sanitizer", "target_cpu", "cxx_standard", "c_standard")

/// The triplet name: the arch, then the profile name with `_` doubled to `--`,
/// since a triplet name holds only lowercase letters, digits and `-`.
function name(p: profile.Profile): String = "\(p.arch)-\(p.name.replaceAll("_", "--"))"

local vcpkgArch: Map<String, String> = Map("amd64", "x64", "arm64", "arm64")
local vcpkgSystem: Map<String, String> = Map("macos", "Darwin", "linux", "Linux")

local function options(p: profile.Profile): List<String> =
  abiAxes.map((a) -> "-D\(presets.variable(a))=\(p.values[a])") +
  List("cxx_standard", "c_standard").flatMap((a) ->
    let (byValue = settings.cacheVariables[a][p.values[a]])
      byValue.keys.toList().map((k) -> "-D\(k)=\(byValue[k])"))

local here: String = "${CMAKE_CURRENT_LIST_DIR}/.."

/// The triplet file's text.
function text(p: profile.Profile): String = (List(
  "# Generated by the profile catalogue for profile \(p.name); do not edit.",
  "set(VCPKG_TARGET_ARCHITECTURE \(vcpkgArch[p.arch]))",
  "set(VCPKG_CRT_LINKAGE dynamic)",
  "set(VCPKG_LIBRARY_LINKAGE static)",
  "set(VCPKG_CMAKE_SYSTEM_NAME \(vcpkgSystem[p.system]))"
) + (if (p.system == "macos") List("set(VCPKG_OSX_ARCHITECTURES \(p.arch))") else List())
  + (if (p.buildType == "debug") List() else List("set(VCPKG_BUILD_TYPE release)"))
  + List(
    "set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE \"\(here)/ProfileToolchain.cmake\")",
    "set(VCPKG_CMAKE_CONFIGURE_OPTIONS" + options(p).map((o) -> " " + cmake.quote(o)).join("") + ")",
    "set(VCPKG_HASH_ADDITIONAL_FILES",
    "  \"\(here)/ProfileToolchain.cmake\"",
    "  \"\(here)/ProfileCommon.cmake\"",
    "  \"\(here)/profile-data.cmake\")"
  )).join("\n") + "\n"
