/// Renders `profile-data.cmake`, the catalogue's tables as CMake variables,
/// and reads the static CMake files that use them.
module cmake

import "../axes.pkl"
import "../compilers.pkl"
import "../rules.pkl"
import "../settings.pkl"

/// A CMake quoted argument.
function quote(s: String): String =
  "\"" + s.replaceAll(#"\"#, #"\\"#).replaceAll("\"", #"\""#).replaceAll("$", #"\$"#).replaceAll(";", #"\;"#) + "\""

local function set(name: String, values: List<String>): String =
  "set(\(name)" + values.map((v) -> " " + quote(v)).join("") + ")"

local function lines(blocks: List<String>): String = blocks.join("\n") + "\n"

local axisLines: List<String> = List(
  set("PROFILE_NAME_AXES", axes.nameAxes),
  set("PROFILE_CONTEXT_AXES", axes.contextAxes),
  set("PROFILE_SANITIZER_MEMBERS", axes.sanitizers)
) + axes.axisValues.keys.toList().map((a) -> set("PROFILE_AXIS_\(a)_VALUES", axes.axisValues[a]))

local compilerLines: List<String> =
  List(set("PROFILE_COMPILERS", compilers.compilers.keys.toList())) +
  compilers.compilers.keys.toList().flatMap((k) ->
    let (c = compilers.compilers[k])
      List(
        set("PROFILE_COMPILER_\(k)_ID", List(c.id)),
        set("PROFILE_COMPILER_\(k)_VERSION", List(c.version)),
        set("PROFILE_COMPILER_\(k)_COMMIT", if (c.commit != null) List(c.commit!!) else List())
      ) +
      c.c.keys.toList().map((s) -> set("PROFILE_COMPILER_\(k)_C_\(s)", List(c.c[s]))) +
      c.cxx.keys.toList().map((s) -> set("PROFILE_COMPILER_\(k)_CXX_\(s)", List(c.cxx[s]))))

local settingLines: List<String> =
  settings.cacheVariables.keys.toList().flatMap((a) ->
    let (byValue = settings.cacheVariables[a])
      byValue.keys.toList().map((v) ->
        set("PROFILE_SETTINGS_\(a)_\(v)", byValue[v].keys.toList().map((k) -> "\(k)=\(byValue[v][k])"))))

local flagLines: List<String> =
  List(set("PROFILE_FLAG_ROWS", IntSeq(1, settings.flags.length).toList().map((i) -> i.toString()))) +
  IntSeq(1, settings.flags.length).toList().flatMap((i) ->
    let (f = settings.flags[i - 1])
      List(
        set("PROFILE_FLAG_\(i)_AXIS", List(f.axis)),
        set("PROFILE_FLAG_\(i)_VALUE", List(f.value)),
        set("PROFILE_FLAG_\(i)_COMPILERS", f.compilers),
        set("PROFILE_FLAG_\(i)_LANGUAGES", f.languages),
        set("PROFILE_FLAG_\(i)_COMPILE", f.compile),
        set("PROFILE_FLAG_\(i)_LINK", f.link)
      ))

local ruleLines: List<String> =
  List(set("PROFILE_RULES", rules.rules.map((r) -> r.id))) +
  rules.rules.flatMap((r) ->
    List(
      set("PROFILE_RULE_\(r.id)_MESSAGE", List(r.message)),
      set("PROFILE_RULE_\(r.id)_CONDITIONS", IntSeq(1, r.conditions.length).toList().map((i) -> i.toString()))
    ) + IntSeq(1, r.conditions.length).toList().flatMap((i) ->
      let (c = r.conditions[i - 1])
        List(
          set("PROFILE_RULE_\(r.id)_\(i)_AXIS", List(c.axis)),
          set("PROFILE_RULE_\(r.id)_\(i)_NEGATED", List(if (c.negated) "TRUE" else "FALSE")),
          set("PROFILE_RULE_\(r.id)_\(i)_VALUES", c.values)
        )))

/// `profile-data.cmake`.
data: String = lines(List(
  "# Generated by the profile catalogue; do not edit.",
  "# The catalogue's axes, compilers, settings, flags and rules for ProfileCommon.cmake.",
  "include_guard(GLOBAL)"
) + axisLines + compilerLines + settingLines + flagLines + ruleLines)

/// The static CMake files, by file name.
staticFiles: Map<String, String> = Map(
  "ProfileCommon.cmake", read("../cmake/ProfileCommon.cmake").text,
  "ProfileToolchain.cmake", read("../cmake/ProfileToolchain.cmake").text,
  "ProfileRules.cmake", read("../cmake/ProfileRules.cmake").text,
  "ProfileCheck.cmake", read("../cmake/ProfileCheck.cmake").text,
  "ProfileOverrides.cmake", read("../cmake/ProfileOverrides.cmake").text
)
