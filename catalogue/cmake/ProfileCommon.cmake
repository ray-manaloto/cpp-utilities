# Shared by ProfileToolchain.cmake and ProfileCheck.cmake. It reads the
# catalogue's tables from profile-data.cmake, emitted beside it.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/profile-data.cmake")

# The sanitizers a sanitizer value holds: none for `none`, else its `_` parts.
function(profile_sanitizer_members value out)
  if(value STREQUAL "none" OR value STREQUAL "")
    set(${out} "" PARENT_SCOPE)
  else()
    string(REPLACE "_" ";" members "${value}")
    set(${out} "${members}" PARENT_SCOPE)
  endif()
endfunction()

# The flags the profile in PROFILE_<AXIS> adds: compile flags for <lang>, and link flags.
function(profile_flags lang out_compile out_link)
  set(compile "")
  set(link "")
  profile_sanitizer_members("${PROFILE_SANITIZER}" members)
  foreach(i IN LISTS PROFILE_FLAG_ROWS)
    set(axis "${PROFILE_FLAG_${i}_AXIS}")
    set(value "${PROFILE_FLAG_${i}_VALUE}")
    if(axis STREQUAL "sanitizers")
      if(NOT value IN_LIST members)
        continue()
      endif()
    else()
      string(TOUPPER "${axis}" up)
      if(NOT "${PROFILE_${up}}" STREQUAL "${value}")
        continue()
      endif()
    endif()
    if(PROFILE_FLAG_${i}_COMPILERS AND NOT "${PROFILE_COMPILER}" IN_LIST PROFILE_FLAG_${i}_COMPILERS)
      continue()
    endif()
    if(lang IN_LIST PROFILE_FLAG_${i}_LANGUAGES)
      list(APPEND compile ${PROFILE_FLAG_${i}_COMPILE})
    endif()
    list(APPEND link ${PROFILE_FLAG_${i}_LINK})
  endforeach()
  list(REMOVE_DUPLICATES compile)
  list(REMOVE_DUPLICATES link)
  set(${out_compile} "${compile}" PARENT_SCOPE)
  set(${out_link} "${link}" PARENT_SCOPE)
endfunction()

# Stops configure listing every refusal, if there are any.
function(profile_refuse refusals)
  if(refusals)
    list(JOIN refusals "\n  " text)
    message(FATAL_ERROR "Profile ${PROFILE_NAME} refused:\n  ${text}")
  endif()
endfunction()

# Sets <out> to a refusal for each flag in <required> that a later flag in
# <vars> undoes. <vars> are read in order, as the compiler sees them: the base
# variable, then a configuration's. A flag is undone by:
# - -fno-sanitize=<names> or =all, for a sanitizer a -fsanitize= flag turns on,
#   unless a later -fsanitize= turns it on again;
# - -f<x> after -fno-<x>, or -fno-<x> or -f<x>=<value> after -f<x>;
# - -<opt>=<other> after -<opt>=<value>.
# Flags a project adds itself, such as with add_compile_options, are not seen,
# nor is turning off one check of a group, such as -fno-sanitize=alignment
# under -fsanitize=undefined.
function(_profile_undone required vars out)
  set(refusals "")
  # A token may hold a ';', as in -DSEP="a;b". It stands in as an ASCII SOH
  # so that each token stays one list item, and is put back, escaped, in a
  # refusal.
  string(ASCII 1 semicolon)
  set(tokens_in_order "")
  set(token_vars "")
  foreach(var IN LISTS vars)
    string(REPLACE ";" "${semicolon}" flags "${${var}}")
    separate_arguments(tokens NATIVE_COMMAND "${flags}")
    foreach(token IN LISTS tokens)
      list(APPEND tokens_in_order "${token}")
      list(APPEND token_vars "${var}")
    endforeach()
  endforeach()

  set(wanted "")
  foreach(flag IN LISTS required)
    if(flag MATCHES "^-fsanitize=(.+)$")
      string(REPLACE "," ";" names "${CMAKE_MATCH_1}")
      list(APPEND wanted ${names})
    endif()
  endforeach()
  set(enabled "")
  set(i 0)
  foreach(token IN LISTS tokens_in_order)
    list(GET token_vars ${i} var)
    math(EXPR i "${i} + 1")
    if(token MATCHES "^-f(no-)?sanitize=(.+)$")
      set(negated "${CMAKE_MATCH_1}")
      string(REPLACE "," ";" names "${CMAKE_MATCH_2}")
      if(negated AND "all" IN_LIST names)
        set(names ${wanted})
      endif()
      foreach(name IN LISTS names)
        if(negated)
          list(REMOVE_ITEM enabled "${name}")
          set(off_${name} "${var}")
        else()
          list(APPEND enabled "${name}")
          unset(off_${name})
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(name IN LISTS wanted)
    if(NOT name IN_LIST enabled AND DEFINED off_${name})
      list(APPEND refusals "${off_${name}} turns off sanitizer ${name}, which the profile turns on")
    endif()
  endforeach()

  foreach(flag IN LISTS required)
    if(flag MATCHES "^-f(no-)?sanitize=")
      continue()
    endif()
    set(negation "")
    set(prefix "")
    if(flag MATCHES "^-fno-([^=]+)$")
      set(negation "-f${CMAKE_MATCH_1}")
    elseif(flag MATCHES "^-f([^=]+)$")
      set(negation "-fno-${CMAKE_MATCH_1}")
      set(prefix "${flag}=")
    elseif(flag MATCHES "^(-[^=]+=)")
      set(prefix "${CMAKE_MATCH_1}")
    endif()
    set(last -1)
    set(i 0)
    foreach(token IN LISTS tokens_in_order)
      if(token STREQUAL flag)
        set(last ${i})
      endif()
      math(EXPR i "${i} + 1")
    endforeach()
    if(last LESS 0)
      continue()
    endif()
    set(i 0)
    foreach(token IN LISTS tokens_in_order)
      if(i GREATER last)
        string(FIND "${token}" "${prefix}" at)
        if((negation AND token STREQUAL negation) OR (prefix AND at EQUAL 0))
          list(GET token_vars ${i} var)
          string(REPLACE "${semicolon}" "\\;" token "${token}")
          list(APPEND refusals "${var} has ${token} after ${flag}, which the profile adds")
        endif()
      endif()
      math(EXPR i "${i} + 1")
    endforeach()
  endforeach()
  set(${out} "${refusals}" PARENT_SCOPE)
endfunction()

# Appends to <out> the refusals of _profile_undone for <base> followed by
# <base>_<CONFIG>, for each configuration the build can use, or for <base>
# alone when it names none.
function(_profile_undone_in required base out)
  get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(multi_config)
    set(configs ${CMAKE_CONFIGURATION_TYPES})
  else()
    set(configs ${CMAKE_BUILD_TYPE})
  endif()
  set(found "")
  if(NOT configs)
    _profile_undone("${required}" "${base}" found)
  endif()
  foreach(config IN LISTS configs)
    string(TOUPPER "${config}" upper)
    _profile_undone("${required}" "${base};${base}_${upper}" here)
    list(APPEND found ${here})
  endforeach()
  list(REMOVE_DUPLICATES found)
  set(${out} ${${out}} ${found} PARENT_SCOPE)
endfunction()
