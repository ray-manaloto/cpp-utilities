  ["cmake/profile/profile-data.cmake"] {
    """
    # Generated by the profile catalogue; do not edit.
    # The catalogue's axes, compilers, settings, flags and rules for ProfileCommon.cmake.
    include_guard(GLOBAL)
    set(PROFILE_NAME_AXES "system" "compiler" "build_type" "ipo" "sanitizer" "instrumentation" "target_cpu" "cxx_standard" "c_standard" "gnu_extensions" "import_std" "reflection" "pch")
    set(PROFILE_CONTEXT_AXES "arch" "generator" "launcher")
    set(PROFILE_SANITIZER_MEMBERS "asan" "ubsan" "lsan" "tsan" "msan" "hwasan" "rtsan" "tysan" "nsan")
