  ["cmake/profile/ProfileCommon.cmake"] {
    #"""
    # Shared by ProfileToolchain.cmake and ProfileCheck.cmake. It reads the
    # catalogue's tables from profile-data.cmake, emitted beside it.
    include_guard(GLOBAL)
    include("${CMAKE_CURRENT_LIST_DIR}/profile-data.cmake")
    
    # The sanitizers a sanitizer value holds: none for `none`, else its `_` parts.
    function(profile_sanitizer_members value out)
      if(value STREQUAL "none" OR value STREQUAL "")
        set(${out} "" PARENT_SCOPE)
      else()
        string(REPLACE "_" ";" members "${value}")
        set(${out} "${members}" PARENT_SCOPE)
      endif()
    endfunction()
    
    # The flags the profile in PROFILE_<AXIS> adds: compile flags for <lang>, and link flags.
    function(profile_flags lang out_compile out_link)
      set(compile "")
      set(link "")
      profile_sanitizer_members("${PROFILE_SANITIZER}" members)
      foreach(i IN LISTS PROFILE_FLAG_ROWS)
        set(axis "${PROFILE_FLAG_${i}_AXIS}")
        set(value "${PROFILE_FLAG_${i}_VALUE}")
        if(axis STREQUAL "sanitizers")
          if(NOT value IN_LIST members)
            continue()
          endif()
        else()
          string(TOUPPER "${axis}" up)
          if(NOT "${PROFILE_${up}}" STREQUAL "${value}")
            continue()
          endif()
        endif()
        if(PROFILE_FLAG_${i}_COMPILERS AND NOT "${PROFILE_COMPILER}" IN_LIST PROFILE_FLAG_${i}_COMPILERS)
          continue()
        endif()
        if(lang IN_LIST PROFILE_FLAG_${i}_LANGUAGES)
          list(APPEND compile ${PROFILE_FLAG_${i}_COMPILE})
        endif()
        list(APPEND link ${PROFILE_FLAG_${i}_LINK})
      endforeach()
      list(REMOVE_DUPLICATES compile)
      list(REMOVE_DUPLICATES link)
      set(${out_compile} "${compile}" PARENT_SCOPE)
      set(${out_link} "${link}" PARENT_SCOPE)
    endfunction()
    
    # Stops configure listing every refusal, if there are any.
    function(profile_refuse refusals)
      if(refusals)
        list(JOIN refusals "\n  " text)
        message(FATAL_ERROR "Profile ${PROFILE_NAME} refused:\n  ${text}")
      endif()
    endfunction()
    
    """#
  }
  ["cmake/profile/ProfileToolchain.cmake"] {
    """
    # Profile toolchain file. A Profile preset names it and sets PROFILE_<AXIS>
    # for every name axis; a vcpkg triplet chainloads it with the ABI axes only.
    # It picks the profile's compiler unless CMAKE_<LANG>_COMPILER is already set,
    # and starts the flag variables with the flags the profile adds. The check
    # module then refuses any compiler or flag that differs from the profile.
    include("${CMAKE_CURRENT_LIST_DIR}/ProfileCommon.cmake")
    
    foreach(axis IN LISTS PROFILE_NAME_AXES)
      string(TOUPPER "PROFILE_${axis}" var)
      list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES "${var}")
    endforeach()
    list(REMOVE_DUPLICATES CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)
    
    if(DEFINED PROFILE_COMPILER AND DEFINED PROFILE_SYSTEM)
      foreach(lang IN ITEMS C CXX)
        set(program "PROFILE_COMPILER_${PROFILE_COMPILER}_${lang}_${PROFILE_SYSTEM}")
        if(NOT DEFINED CMAKE_${lang}_COMPILER AND DEFINED ${program})
          set(CMAKE_${lang}_COMPILER "${${program}}")
        endif()
      endforeach()
    endif()
    
    # import std reads the standard library's modules metadata from the path the
    # compiler prints for libc++.modules.json. Some LLVM packages, such as
    # Homebrew's, install it under lib/c++/ where that lookup misses it, so look
    # there too when the profile asks for import std on a clang.
    if(PROFILE_IMPORT_STD STREQUAL "importstd_on" AND NOT DEFINED CMAKE_CXX_STDLIB_MODULES_JSON
        AND "${PROFILE_COMPILER_${PROFILE_COMPILER}_ID}" STREQUAL "Clang" AND DEFINED CMAKE_CXX_COMPILER)
      foreach(candidate IN ITEMS libc++.modules.json c++/libc++.modules.json)
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${candidate}"
          OUTPUT_VARIABLE found OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
        if(NOT failed AND IS_ABSOLUTE "${found}" AND EXISTS "${found}")
          cmake_path(NORMAL_PATH found)
          set(CMAKE_CXX_STDLIB_MODULES_JSON "${found}")
          break()
        endif()
      endforeach()
      unset(candidate)
      unset(found)
      unset(failed)
    endif()
    
    foreach(lang IN ITEMS C CXX)
      profile_flags(${lang} compile link)
      list(JOIN compile " " compile)
      set(CMAKE_${lang}_FLAGS_INIT "${compile}")
    endforeach()
    list(JOIN link " " link)
    foreach(kind IN ITEMS EXE SHARED MODULE)
      set(CMAKE_${kind}_LINKER_FLAGS_INIT "${link}")
    endforeach()
    unset(compile)
    unset(link)
    unset(program)
    
    """
  }
  ["cmake/profile/ProfileRules.cmake"] {
    #"""
    # Profile rules module. A Profile preset loads it before project() through
    # CMAKE_PROJECT_INCLUDE_BEFORE, so a forbidden combination stops configure
    # with the catalogue's reasons before the compiler's own checks run. It
    # refuses an unknown axis value, a PROFILE_NAME that is not the name the values
    # spell, and any catalogue rule the profile and the build's system, arch,
    # generator or launcher break. ProfileCheck.cmake checks the build after project().
    include_guard(GLOBAL)
    include("${CMAKE_CURRENT_LIST_DIR}/ProfileCommon.cmake")
    
    # Sets <out> to the value paired with <key> in the key-value pairs that follow, or to <key>.
    function(_profile_lookup key out)
      set(${out} "${key}" PARENT_SCOPE)
      while(ARGN)
        list(POP_FRONT ARGN k v)
        if(k STREQUAL key)
          set(${out} "${v}" PARENT_SCOPE)
          return()
        endif()
      endwhile()
    endfunction()
    
    function(_profile_check_rules)
      set(refusals "")
      if(NOT PROFILE_NAME)
        message(FATAL_ERROR "Profile check: PROFILE_NAME is not set; configure through a Profile preset")
      endif()
    
      # Axis values and the name they spell.
      set(spelled "")
      foreach(axis IN LISTS PROFILE_NAME_AXES)
        string(TOUPPER "${axis}" up)
        set(value "${PROFILE_${up}}")
        if(axis STREQUAL "sanitizer")
          profile_sanitizer_members("${value}" members)
          set(ordered "")
          foreach(m IN LISTS PROFILE_SANITIZER_MEMBERS)
            if(m IN_LIST members)
              list(APPEND ordered "${m}")
            endif()
          endforeach()
          list(JOIN ordered "_" canonical)
          if(NOT value STREQUAL "none" AND NOT value STREQUAL canonical)
            list(APPEND refusals "PROFILE_SANITIZER=\"${value}\" is not none or sanitizers from {${PROFILE_SANITIZER_MEMBERS}} in that order")
          endif()
        elseif(NOT value IN_LIST PROFILE_AXIS_${axis}_VALUES)
          list(APPEND refusals "PROFILE_${up}=\"${value}\" is not one of {${PROFILE_AXIS_${axis}_VALUES}}")
        endif()
        list(APPEND spelled "${value}")
      endforeach()
      list(JOIN spelled "-" name)
      if(NOT PROFILE_NAME STREQUAL name)
        list(APPEND refusals "PROFILE_NAME is \"${PROFILE_NAME}\" but the axis values spell \"${name}\"")
      endif()
    
      # Context the build decides.
      # The toolchain file does not cross-compile, so the host is the target
      # unless a CMAKE_SYSTEM_NAME was given.
      set(target "${CMAKE_HOST_SYSTEM_NAME}")
      if(CMAKE_SYSTEM_NAME)
        set(target "${CMAKE_SYSTEM_NAME}")
      endif()
      _profile_lookup("${target}" system Darwin macos Linux linux)
      if(NOT system STREQUAL PROFILE_SYSTEM)
        list(APPEND refusals "the build targets ${target} but the profile names ${PROFILE_SYSTEM}")
      endif()
      cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
      if(CMAKE_OSX_ARCHITECTURES)
        set(processor "${CMAKE_OSX_ARCHITECTURES}")
      endif()
      string(TOLOWER "${processor}" processor)
      _profile_lookup("${processor}" context_arch aarch64 arm64 x86_64 amd64)
      _profile_lookup("${CMAKE_GENERATOR}" context_generator
        Ninja ninja "Ninja Multi-Config" ninja_multi_config "Unix Makefiles" unix_makefiles Xcode xcode)
      set(context_launcher "none")
      if(CMAKE_CXX_COMPILER_LAUNCHER)
        list(GET CMAKE_CXX_COMPILER_LAUNCHER 0 launcher)
        get_filename_component(context_launcher "${launcher}" NAME_WE)
      endif()
      foreach(axis IN LISTS PROFILE_CONTEXT_AXES)
        if(NOT context_${axis} IN_LIST PROFILE_AXIS_${axis}_VALUES)
          list(APPEND refusals "${axis} \"${context_${axis}}\" is not one of {${PROFILE_AXIS_${axis}_VALUES}}")
        endif()
      endforeach()
    
      # Catalogue rules.
      profile_sanitizer_members("${PROFILE_SANITIZER}" members)
      foreach(id IN LISTS PROFILE_RULES)
        set(all TRUE)
        foreach(i IN LISTS PROFILE_RULE_${id}_CONDITIONS)
          set(axis "${PROFILE_RULE_${id}_${i}_AXIS}")
          if(axis STREQUAL "sanitizers")
            set(actual "${members}")
          elseif(axis IN_LIST PROFILE_CONTEXT_AXES)
            set(actual "${context_${axis}}")
          else()
            string(TOUPPER "${axis}" up)
            set(actual "${PROFILE_${up}}")
          endif()
          set(hit FALSE)
          foreach(v IN LISTS actual)
            if(v IN_LIST PROFILE_RULE_${id}_${i}_VALUES)
              set(hit TRUE)
            endif()
          endforeach()
          if(PROFILE_RULE_${id}_${i}_NEGATED)
            if(hit)
              set(hit FALSE)
            else()
              set(hit TRUE)
            endif()
          endif()
          if(NOT hit)
            set(all FALSE)
            break()
          endif()
        endforeach()
        if(all)
          list(APPEND refusals "${id}: ${PROFILE_RULE_${id}_MESSAGE}")
        endif()
      endforeach()
    
      profile_refuse("${refusals}")
    endfunction()
    
    _profile_check_rules()
    
    """#
  }
  ["cmake/profile/ProfileCheck.cmake"] {
    #"""
    # Profile check module. A Profile preset loads it after project() through
    # CMAKE_PROJECT_INCLUDE; ProfileRules.cmake has already checked the axis values
    # and rules. It stops configure, listing every reason, when:
    # - a compiler's ID, version or fork commit is not the profile's compiler;
    # - a CMake setting the profile owns, or a flag its toolchain adds, was overridden,
    #   including by a later flag that undoes it, in the base or a configuration's
    #   flags variable;
    # - the compiler or linker refuses a flag the profile adds, or IPO or
    #   import std is asked for and unavailable.
    include_guard(GLOBAL)
    include("${CMAKE_CURRENT_LIST_DIR}/ProfileCommon.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ProfileOverrides.cmake")
    include(CheckCompilerFlag)
    include(CheckLinkerFlag)
    include(CheckIPOSupported)
    
    function(_profile_check_build)
      set(refusals "")
      # Compiler identity.
      get_property(languages GLOBAL PROPERTY ENABLED_LANGUAGES)
      list(FILTER languages INCLUDE REGEX "^(C|CXX)$")
      set(expected "PROFILE_COMPILER_${PROFILE_COMPILER}")
      foreach(lang IN LISTS languages)
        set(id "${CMAKE_${lang}_COMPILER_ID}")
        string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" version "${CMAKE_${lang}_COMPILER_VERSION}")
        execute_process(COMMAND "${CMAKE_${lang}_COMPILER}" --version
          OUTPUT_VARIABLE banner ERROR_QUIET RESULT_VARIABLE ignored)
        set(commit "")
        if(banner MATCHES "clang-p2996\\.git ([0-9a-f]+)")
          string(SUBSTRING "${CMAKE_MATCH_1}" 0 8 commit)
        endif()
        if(NOT id STREQUAL "${${expected}_ID}" OR NOT version STREQUAL "${${expected}_VERSION}"
            OR NOT commit STREQUAL "${${expected}_COMMIT}")
          set(seen "${id} ${version}")
          if(commit)
            string(APPEND seen " commit ${commit}")
          endif()
          set(want "${${expected}_ID} ${${expected}_VERSION}")
          if(${expected}_COMMIT)
            string(APPEND want " commit ${${expected}_COMMIT}")
          endif()
          list(APPEND refusals "the ${lang} compiler ${CMAKE_${lang}_COMPILER} is ${seen}, but the profile names ${PROFILE_COMPILER}: ${want}")
        endif()
      endforeach()
    
      # Settings the profile owns, and the flags its toolchain adds.
      get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
      foreach(axis IN LISTS PROFILE_NAME_AXES)
        string(TOUPPER "${axis}" up)
        foreach(pair IN LISTS PROFILE_SETTINGS_${axis}_${PROFILE_${up}})
          string(FIND "${pair}" "=" at)
          string(SUBSTRING "${pair}" 0 ${at} var)
          math(EXPR at "${at} + 1")
          string(SUBSTRING "${pair}" ${at} -1 want)
          if(var STREQUAL "CMAKE_BUILD_TYPE" AND multi_config)
            continue()
          endif()
          set(same FALSE)
          if(want STREQUAL "ON" OR want STREQUAL "OFF")
            if((want AND ${var}) OR (NOT want AND NOT ${var}))
              set(same TRUE)
            endif()
          elseif("${${var}}" STREQUAL want)
            set(same TRUE)
          endif()
          if(NOT same)
            list(APPEND refusals "${var} is \"${${var}}\" but ${axis} ${PROFILE_${up}} sets \"${want}\"")
          endif()
        endforeach()
      endforeach()
    
      set(link "")
      foreach(lang IN LISTS languages)
        profile_flags(${lang} compile lang_link)
        list(APPEND link ${lang_link})
        _profile_tokens("${CMAKE_${lang}_FLAGS}" actual)
        foreach(flag IN LISTS compile)
          _profile_written_out("${flag}" written_out)
          if(NOT flag IN_LIST actual AND NOT (written_out AND written_out IN_LIST actual))
            list(APPEND refusals "CMAKE_${lang}_FLAGS lacks ${flag}, which the profile adds")
          endif()
        endforeach()
        _profile_undone_in("${compile}" CMAKE_${lang}_FLAGS refusals)
        set(CMAKE_REQUIRED_QUIET ON)
        foreach(flag IN LISTS compile)
          string(MAKE_C_IDENTIFIER "PROFILE_HAS_${lang}_FLAG_${flag}" result)
          unset(${result} CACHE)
          check_compiler_flag(${lang} "${flag}" ${result})
          if(NOT ${result})
            list(APPEND refusals "the ${lang} compiler refuses ${flag}")
          endif()
        endforeach()
      endforeach()
      list(REMOVE_DUPLICATES link)
      _profile_tokens("${CMAKE_EXE_LINKER_FLAGS}" actual)
      foreach(kind IN ITEMS EXE SHARED MODULE)
        _profile_undone_in("${link}" CMAKE_${kind}_LINKER_FLAGS refusals)
      endforeach()
      foreach(flag IN LISTS link)
        if(NOT flag IN_LIST actual)
          list(APPEND refusals "CMAKE_EXE_LINKER_FLAGS lacks ${flag}, which the profile adds")
        endif()
        list(GET languages -1 lang)
        string(MAKE_C_IDENTIFIER "PROFILE_HAS_LINKER_FLAG_${flag}" result)
        unset(${result} CACHE)
        check_linker_flag(${lang} "${flag}" ${result})
        if(NOT ${result})
          list(APPEND refusals "the linker refuses ${flag}")
        endif()
      endforeach()
    
      if(PROFILE_IPO STREQUAL "ipo_on")
        check_ipo_supported(RESULT ipo OUTPUT why LANGUAGES ${languages})
        if(NOT ipo)
          list(APPEND refusals "IPO is not supported: ${why}")
        endif()
      endif()
      if(PROFILE_IMPORT_STD STREQUAL "importstd_on")
        string(REGEX MATCH "[0-9]+" std "${PROFILE_CXX_STANDARD}")
        if(NOT std IN_LIST CMAKE_CXX_COMPILER_IMPORT_STD)
          list(APPEND refusals "import std is not available for C++${std}: ${CMAKE_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE}")
        elseif(NOT IS_ABSOLUTE "${CMAKE_CXX_STDLIB_MODULES_JSON}" OR NOT EXISTS "${CMAKE_CXX_STDLIB_MODULES_JSON}")
          list(APPEND refusals "import std needs the standard library modules metadata, but CMAKE_CXX_STDLIB_MODULES_JSON is \"${CMAKE_CXX_STDLIB_MODULES_JSON}\"")
        endif()
      endif()
    
      profile_refuse("${refusals}")
      message(STATUS "Profile ${PROFILE_NAME}: checks passed")
    endfunction()
    
    _profile_check_build()
    
    """#
  }
  ["cmake/profile/ProfileOverrides.cmake"] {
    #"""
    # The override check ProfileCheck.cmake runs: does a later flag undo one the
    # profile adds? It lives apart from ProfileCommon.cmake, which the triplets
    # hash for vcpkg's binary cache, because it never changes how a dependency
    # is built. tools/overrides-test.cmake tests it with cmake -P.
    include_guard(GLOBAL)
    
    # Sets <out> to the arguments in <flags>, as the compiler reads them. A list
    # item ends at a ';' outside square brackets, so an argument may not hold its
    # own ';', '[' or ']', as -DSEP="a;b" or -DLBRACKET=[ do: each stands in as
    # ASCII 1, 2 or 3 until _profile_untokens puts it back.
    function(_profile_tokens flags out)
      string(ASCII 1 semicolon)
      string(ASCII 2 lbracket)
      string(ASCII 3 rbracket)
      string(REPLACE ";" "${semicolon}" flags "${flags}")
      string(REPLACE "[" "${lbracket}" flags "${flags}")
      string(REPLACE "]" "${rbracket}" flags "${flags}")
      separate_arguments(tokens NATIVE_COMMAND "${flags}")
      set(${out} "${tokens}" PARENT_SCOPE)
    endfunction()
    
    # Sets <out> to the list <items>, with the stand-ins _profile_tokens put in
    # its tokens turned back into '\;', '[' and ']'.
    function(_profile_untokens items out)
      string(ASCII 1 semicolon)
      string(ASCII 2 lbracket)
      string(ASCII 3 rbracket)
      string(REPLACE "${semicolon}" "\\;" items "${items}")
      string(REPLACE "${lbracket}" "[" items "${items}")
      string(REPLACE "${rbracket}" "]" items "${items}")
      set(${out} "${items}" PARENT_SCOPE)
    endfunction()
    
    # Sets <out> to the written-out form of the bare flag <flag>, -f<x>=<value>
    # with the value a bare -f<x> means, or to "" where none is known.
    function(_profile_written_out flag out)
      set(value_-fsanitize-memory-track-origins 2)
      if(DEFINED value_${flag})
        set(${out} "${flag}=${value_${flag}}" PARENT_SCOPE)
      else()
        set(${out} "" PARENT_SCOPE)
      endif()
    endfunction()
    
    # Sets <out> to a refusal for each flag in <required> that a later flag in
    # <vars> undoes. <vars> are read in order, as the compiler sees them: the base
    # variable, then a configuration's. A flag is undone by:
    # - -fno-sanitize=<names> or =all, for a sanitizer a -fsanitize= flag turns on,
    #   unless a later -fsanitize= turns it on again;
    # - -f<x> after -fno-<x>, or -fno-<x> or -f<x>=<value> after -f<x>, or
    #   -fno-<x> after -f<x>=<value>;
    # - -<opt>=<other> after -<opt>=<value>.
    # The written-out form of a bare flag (_profile_written_out) stands for it:
    # it is no undo, and a later flag can undo it.
    # Flags a project adds itself, such as with add_compile_options, are not seen,
    # nor is turning off one check of a group, such as -fno-sanitize=alignment
    # under -fsanitize=undefined.
    function(_profile_undone required vars out)
      set(refusals "")
      string(ASCII 1 semicolon)
      set(tokens_in_order "")
      set(token_vars "")
      foreach(var IN LISTS vars)
        _profile_tokens("${${var}}" tokens)
        foreach(token IN LISTS tokens)
          list(APPEND tokens_in_order "${token}")
          list(APPEND token_vars "${var}")
        endforeach()
      endforeach()
    
      set(wanted "")
      foreach(flag IN LISTS required)
        if(flag MATCHES "^-fsanitize=(.+)$")
          string(REPLACE "," ";" names "${CMAKE_MATCH_1}")
          list(APPEND wanted ${names})
        endif()
      endforeach()
      set(enabled "")
      set(i 0)
      foreach(token IN LISTS tokens_in_order)
        list(GET token_vars ${i} var)
        math(EXPR i "${i} + 1")
        if(token MATCHES "^-f(no-)?sanitize=(.+)$")
          set(negated "${CMAKE_MATCH_1}")
          # A bare ';' separates names here, as a ',' does.
          string(REGEX REPLACE "[,${semicolon}]" ";" names "${CMAKE_MATCH_2}")
          if(negated AND "all" IN_LIST names)
            set(names ${wanted})
          endif()
          foreach(name IN LISTS names)
            if(negated)
              list(REMOVE_ITEM enabled "${name}")
              set(off_${name} "${var}")
            else()
              list(APPEND enabled "${name}")
              unset(off_${name})
            endif()
          endforeach()
        endif()
      endforeach()
      foreach(name IN LISTS wanted)
        if(NOT name IN_LIST enabled AND DEFINED off_${name})
          list(APPEND refusals "${off_${name}} turns off sanitizer ${name}, which the profile turns on")
        endif()
      endforeach()
    
      foreach(flag IN LISTS required)
        if(flag MATCHES "^-f(no-)?sanitize=")
          continue()
        endif()
        set(negation "")
        set(prefix "")
        set(written_out "")
        if(flag MATCHES "^-fno-([^=]+)$")
          set(negation "-f${CMAKE_MATCH_1}")
        elseif(flag MATCHES "^-f([^=]+)$")
          set(negation "-fno-${CMAKE_MATCH_1}")
          set(prefix "${flag}=")
          _profile_written_out("${flag}" written_out)
        elseif(flag MATCHES "^(-[^=]+=)")
          set(prefix "${CMAKE_MATCH_1}")
          if(flag MATCHES "^-f([^=]+)=")
            set(negation "-fno-${CMAKE_MATCH_1}")
          endif()
        endif()
        set(last -1)
        set(i 0)
        foreach(token IN LISTS tokens_in_order)
          if(token STREQUAL flag OR (written_out AND token STREQUAL written_out))
            set(last ${i})
          endif()
          math(EXPR i "${i} + 1")
        endforeach()
        if(last LESS 0)
          continue()
        endif()
        set(i 0)
        foreach(token IN LISTS tokens_in_order)
          if(i GREATER last)
            string(FIND "${token}" "${prefix}" at)
            if((negation AND token STREQUAL negation)
                OR (prefix AND at EQUAL 0 AND NOT token STREQUAL written_out))
              list(GET token_vars ${i} var)
              list(APPEND refusals "${var} has ${token} after ${flag}, which the profile adds")
            endif()
          endif()
          math(EXPR i "${i} + 1")
        endforeach()
      endforeach()
      set(${out} "${refusals}" PARENT_SCOPE)
    endfunction()
    
    # Appends to <out> the refusals of _profile_undone for <base> followed by
    # <base>_<CONFIG>, for each configuration the build can use, or for <base>
    # alone when it names none.
    function(_profile_undone_in required base out)
      get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
      if(multi_config)
        set(configs ${CMAKE_CONFIGURATION_TYPES})
      else()
        set(configs ${CMAKE_BUILD_TYPE})
      endif()
      set(found "")
      if(NOT configs)
        _profile_undone("${required}" "${base}" found)
      endif()
      foreach(config IN LISTS configs)
        string(TOUPPER "${config}" upper)
        _profile_undone("${required}" "${base};${base}_${upper}" here)
        if(here)
          list(APPEND found "${here}")
        endif()
      endforeach()
      list(REMOVE_DUPLICATES found)
      _profile_untokens("${found}" found)
      set(all "${${out}}")
      if(found)
        list(APPEND all "${found}")
      endif()
      set(${out} "${all}" PARENT_SCOPE)
    endfunction()
    
    """#
  }
  ["cmake/profile/triplets/arm64-macos-clang23--1--4-debug-ipo--off-asan--ubsan-none-native-cxx23-c17-gnu--off-importstd--off-refl--off-pch--off.cmake"] {
    """
    # Generated by the profile catalogue for profile macos-clang23_1_4-debug-ipo_off-asan_ubsan-none-native-cxx23-c17-gnu_off-importstd_off-refl_off-pch_off; do not edit.
    set(VCPKG_TARGET_ARCHITECTURE arm64)
    set(VCPKG_CRT_LINKAGE dynamic)
    set(VCPKG_LIBRARY_LINKAGE static)
    set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
    set(VCPKG_OSX_ARCHITECTURES arm64)
    set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../ProfileToolchain.cmake")
    set(VCPKG_CMAKE_CONFIGURE_OPTIONS "-DPROFILE_SYSTEM=macos" "-DPROFILE_COMPILER=clang23_1_4" "-DPROFILE_SANITIZER=asan_ubsan" "-DPROFILE_TARGET_CPU=native" "-DPROFILE_CXX_STANDARD=cxx23" "-DPROFILE_C_STANDARD=c17" "-DCMAKE_CXX_STANDARD=23" "-DCMAKE_CXX_STANDARD_REQUIRED=ON" "-DCMAKE_C_STANDARD=17" "-DCMAKE_C_STANDARD_REQUIRED=ON")
    set(VCPKG_HASH_ADDITIONAL_FILES
      "${CMAKE_CURRENT_LIST_DIR}/../ProfileToolchain.cmake"
      "${CMAKE_CURRENT_LIST_DIR}/../ProfileCommon.cmake"
      "${CMAKE_CURRENT_LIST_DIR}/../profile-data.cmake")
    
    """
  }
  ["cmake/profile/triplets/amd64-linux-clangp2996--f17c8d6c-release-ipo--off-none-none-native-cxx26-c17-gnu--off-importstd--off-refl--on-pch--off.cmake"] {
    """
    # Generated by the profile catalogue for profile linux-clangp2996_f17c8d6c-release-ipo_off-none-none-native-cxx26-c17-gnu_off-importstd_off-refl_on-pch_off; do not edit.
    set(VCPKG_TARGET_ARCHITECTURE x64)
    set(VCPKG_CRT_LINKAGE dynamic)
    set(VCPKG_LIBRARY_LINKAGE static)
    set(VCPKG_CMAKE_SYSTEM_NAME Linux)
    set(VCPKG_BUILD_TYPE release)
    set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../ProfileToolchain.cmake")
    set(VCPKG_CMAKE_CONFIGURE_OPTIONS "-DPROFILE_SYSTEM=linux" "-DPROFILE_COMPILER=clangp2996_f17c8d6c" "-DPROFILE_SANITIZER=none" "-DPROFILE_TARGET_CPU=native" "-DPROFILE_CXX_STANDARD=cxx26" "-DPROFILE_C_STANDARD=c17" "-DCMAKE_CXX_STANDARD=26" "-DCMAKE_CXX_STANDARD_REQUIRED=ON" "-DCMAKE_C_STANDARD=17" "-DCMAKE_C_STANDARD_REQUIRED=ON")
