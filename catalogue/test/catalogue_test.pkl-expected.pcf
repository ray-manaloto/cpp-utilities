  ["cmake/presets/profiles.json"] {
    """
    {
      "version": 10,
      "include": [
        "system.json",
        "compiler.json",
        "build_type.json",
        "ipo.json",
        "sanitizer.json",
        "instrumentation.json",
        "target_cpu.json",
        "cxx_standard.json",
        "c_standard.json",
        "gnu_extensions.json",
        "import_std.json",
        "reflection.json",
        "pch.json"
      ],
      "configurePresets": [
        {
          "name": "profile-base",
          "hidden": true,
          "toolchainFile": "${sourceDir}/cmake/profile/ProfileToolchain.cmake",
          "cacheVariables": {
            "CMAKE_PROJECT_INCLUDE_BEFORE": "${sourceDir}/cmake/profile/ProfileRules.cmake",
            "CMAKE_PROJECT_INCLUDE": "${sourceDir}/cmake/profile/ProfileCheck.cmake"
          }
        },
        {
          "name": "macos-clang23_1_4-debug-ipo_off-asan_ubsan-none-native-cxx23-c17-gnu_off-importstd_off-refl_off-pch_off",
          "hidden": true,
          "inherits": [
            "profile-base",
            "system-macos",
            "compiler-clang23_1_4",
            "build_type-debug",
            "ipo-ipo_off",
            "sanitizer-asan_ubsan",
            "instrumentation-none",
            "target_cpu-native",
            "cxx_standard-cxx23",
            "c_standard-c17",
            "gnu_extensions-gnu_off",
            "import_std-importstd_off",
            "reflection-refl_off",
            "pch-pch_off"
          ],
          "cacheVariables": {
            "PROFILE_NAME": "macos-clang23_1_4-debug-ipo_off-asan_ubsan-none-native-cxx23-c17-gnu_off-importstd_off-refl_off-pch_off"
          }
        },
        {
          "name": "linux-clangp2996_f17c8d6c-release-ipo_off-none-none-native-cxx26-c17-gnu_off-importstd_off-refl_on-pch_off",
          "hidden": true,
          "inherits": [
            "profile-base",
            "system-linux",
            "compiler-clangp2996_f17c8d6c",
            "build_type-release",
            "ipo-ipo_off",
            "sanitizer-none",
            "instrumentation-none",
            "target_cpu-native",
            "cxx_standard-cxx26",
            "c_standard-c17",
            "gnu_extensions-gnu_off",
            "import_std-importstd_off",
            "reflection-refl_on",
            "pch-pch_off"
          ],
          "cacheVariables": {
