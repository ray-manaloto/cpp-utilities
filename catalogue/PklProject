amends "pkl:Project"

package {
  name = "profile-catalogue"
  baseUri = "package://pkg.pkl-lang.org/github.com/ray-manaloto/cpp-utilities/\(name)"
  version = "0.1.0"
  packageZipUrl = "https://github.com/ray-manaloto/cpp-utilities/releases/download/\(name)@\(version)/\(name)@\(version).zip"
